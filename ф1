import tkinter as tk
from tkinter import ttk, messagebox
import requests
import json
import os
from datetime import datetime

class GitHubUserFinder:
    def __init__(self, root):
        self.root = root
        self.root.title("GitHub User Finder")
        self.root.geometry("700x600")
        
        # Файл для сохранения избранных
        self.favorites_file = "favorites.json"
        self.favorites = self.load_favorites()
        
        # Создание GUI
        self.create_widgets()
        
        # Обновление списка избранных
        self.update_favorites_list()
    
    def create_widgets(self):
        # Рамка поиска
        search_frame = ttk.LabelFrame(self.root, text="Поиск пользователя", padding=10)
        search_frame.pack(fill="x", padx=10, pady=5)
        
        ttk.Label(search_frame, text="Имя пользователя:").pack(side="left", padx=5)
        self.search_entry = ttk.Entry(search_frame, width=30)
        self.search_entry.pack(side="left", padx=5)
        self.search_entry.bind("<Return>", lambda e: self.search_user())
        
        ttk.Button(search_frame, text="Поиск", command=self.search_user).pack(side="left", padx=5)
        
        # Рамка результатов
        results_frame = ttk.LabelFrame(self.root, text="Результаты поиска", padding=10)
        results_frame.pack(fill="both", expand=True, padx=10, pady=5)
        
        # Список результатов
        self.results_listbox = tk.Listbox(results_frame, height=8)
        self.results_listbox.pack(fill="both", expand=True, padx=5, pady=5)
        self.results_listbox.bind("<<ListboxSelect>>", self.on_result_select)
        
        # Кнопки для результатов
        result_buttons = ttk.Frame(results_frame)
        result_buttons.pack(fill="x", pady=5)
        ttk.Button(result_buttons, text="Добавить в избранное", 
                  command=self.add_to_favorites).pack(side="left", padx=5)
        ttk.Button(result_buttons, text="Показать детали", 
                  command=self.show_user_details).pack(side="left", padx=5)
        
        # Рамка избранного
        fav_frame = ttk.LabelFrame(self.root, text="Избранные пользователи", padding=10)
        fav_frame.pack(fill="both", expand=True, padx=10, pady=5)
        
        # Список избранных
        self.fav_listbox = tk.Listbox(fav_frame, height=6)
        self.fav_listbox.pack(fill="both", expand=True, padx=5, pady=5)
        self.fav_listbox.bind("<<ListboxSelect>>", self.on_fav_select)
        
        # Кнопки для избранных
        fav_buttons = ttk.Frame(fav_frame)
        fav_buttons.pack(fill="x", pady=5)
        ttk.Button(fav_buttons, text="Удалить из избранного", 
                  command=self.remove_from_favorites).pack(side="left", padx=5)
        ttk.Button(fav_buttons, text="Обновить данные", 
                  command=self.refresh_favorites).pack(side="left", padx=5)
        
        # Статусная строка
        self.status_var = tk.StringVar()
        self.status_var.set("Готов к работе")
        status_bar = ttk.Label(self.root, textvariable=self.status_var, relief="sunken")
        status_bar.pack(fill="x", padx=10, pady=5)
    
    def load_favorites(self):
        """Загрузка избранных из JSON файла"""
        if os.path.exists(self.favorites_file):
            try:
                with open(self.favorites_file, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                return []
        return []
    
    def save_favorites(self):
        """Сохранение избранных в JSON файл"""
        with open(self.favorites_file, 'w', encoding='utf-8') as f:
            json.dump(self.favorites, f, ensure_ascii=False, indent=2)
    
    def search_user(self):
        """Поиск пользователя на GitHub"""
        username = self.search_entry.get().strip()
        
        # Проверка на пустое поле
        if not username:
            messagebox.showwarning("Ошибка", "Поле поиска не может быть пустым!")
            return
        
        self.status_var.set(f"Поиск пользователя: {username}...")
        self.root.update()
        
        try:
            # Запрос к GitHub API
            url = f"https://api.github.com/users/{username}"
            response = requests.get(url)
            
            if response.status_code == 200:
                user_data = response.json()
                self.display_result(user_data)
                self.status_var.set(f"Найден пользователь: {user_data['login']}")
            elif response.status_code == 404:
                messagebox.showerror("Ошибка", f"Пользователь '{username}' не найден!")
                self.status_var.set("Пользователь не найден")
            else:
                messagebox.showerror("Ошибка", f"Ошибка API: {response.status_code}")
                self.status_var.set("Ошибка при поиске")
                
        except requests.RequestException as e:
            messagebox.showerror("Ошибка", f"Ошибка соединения: {str(e)}")
            self.status_var.set("Ошибка сети")
    
    def display_result(self, user_data):
        """Отображение результата поиска"""
        self.results_listbox.delete(0, tk.END)
        
        info = f"@{user_data['login']} - {user_data.get('name', 'No name')}"
        self.results_listbox.insert(0, info)
        
        # Сохраняем данные пользователя для дальнейшего использования
        self.current_result = user_data
    
    def on_result_select(self, event):
        """Обработка выбора результата"""
        if self.results_listbox.curselection():
            pass  # Можно добавить дополнительную логику
    
    def on_fav_select(self, event):
        """Обработка выбора избранного"""
        if self.fav_listbox.curselection():
            pass
    
    def add_to_favorites(self):
        """Добавление пользователя в избранное"""
        if not hasattr(self, 'current_result'):
            messagebox.showwarning("Ошибка", "Сначала найдите пользователя!")
            return
        
        user = self.current_result
        username = user['login']
        
        # Проверка, не добавлен ли уже пользователь
        for fav in self.favorites:
            if fav['login'] == username:
                messagebox.showinfo("Информация", f"Пользователь {username} уже в избранном!")
                return
        
        # Добавляем в избранное
        favorite_user = {
            'login': user['login'],
            'name': user.get('name', 'No name'),
            'html_url': user['html_url'],
            'avatar_url': user['avatar_url'],
            'added_date': datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        
        self.favorites.append(favorite_user)
        self.save_favorites()
        self.update_favorites_list()
        self.status_var.set(f"Пользователь {username} добавлен в избранное")
    
    def remove_from_favorites(self):
        """Удаление пользователя из избранного"""
        selection = self.fav_listbox.curselection()
        if not selection:
            messagebox.showwarning("Ошибка", "Выберите пользователя для удаления!")
            return
        
        index = selection[0]
        removed_user = self.favorites.pop(index)
        self.save_favorites()
        self.update_favorites_list()
        self.status_var.set(f"Пользователь {removed_user['login']} удален из избранного")
    
    def update_favorites_list(self):
        """Обновление списка избранных"""
        self.fav_listbox.delete(0, tk.END)
        for fav in self.favorites:
            display_text = f"{fav['login']} - {fav['name']} (добавлен: {fav['added_date']})"
            self.fav_listbox.insert(tk.END, display_text)
    
    def show_user_details(self):
        """Показ детальной информации о пользователе"""
        if hasattr(self, 'current_result'):
            user = self.current_result
            details = f"""
Логин: {user['login']}
Имя: {user.get('name', 'Не указано')}
Компания: {user.get('company', 'Не указано')}
Блог: {user.get('blog', 'Не указано')}
Локация: {user.get('location', 'Не указано')}
Репозиториев: {user.get('public_repos', 0)}
Подписчиков: {user.get('followers', 0)}
Подписок: {user.get('following', 0)}
Создан: {user.get('created_at', 'Не указано')}
Профиль: {user['html_url']}
            """
            messagebox.showinfo("Детали пользователя", details)
        else:
            messagebox.showwarning("Ошибка", "Нет выбранного пользователя!")
    
    def refresh_favorites(self):
        """Обновление данных избранных пользователей"""
        if not self.favorites:
            messagebox.showinfo("Информация", "Список избранных пуст")
            return
        
        for fav in self.favorites:
            try:
                url = f"https://api.github.com/users/{fav['login']}"
                response = requests.get(url)
                if response.status_code == 200:
                    updated_data = response.json()
                    fav['name'] = updated_data.get('name', 'No name')
            except:
                pass
        
        self.save_favorites()
        self.update_favorites_list()
        self.status_var.set("Данные избранных обновлены")

if __name__ == "__main__":
    root = tk.Tk()
    app = GitHubUserFinder(root)
    root.mainloop()